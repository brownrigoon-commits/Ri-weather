# 조립 산출물 — 충돌 시 tools/sync.py 가 재생성으로 해결
js/holeimgdb.js -diff

# 이미지·엑셀은 바이너리로 취급 (줄바꿈 변환 금지)
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.xlsx binary
*.mp4 binary

# 텍스트는 저장소에 LF로 통일 (집·회사 줄바꿈 차이로 인한 가짜 충돌 방지)
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf

# 윈도우에서 돌아가는 스크립트만 예외 — 반드시 CRLF 로 내려받아야 합니다.
# (배치 파일이 LF 로 정규화되면 "goto :eof" 같은 줄이 깨져 더블클릭이 그냥 죽습니다.
#  사장님 PC 의 core.autocrlf 설정이 집·회사에서 달라도 여기서 강제됩니다)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
