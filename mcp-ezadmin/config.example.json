    "accounts": [],
    "endpoints": {
      "orders": {
        "method": "GET",
        "path": "",
        "params": { "sdate": "{start_date}", "edate": "{end_date}" },
        "record_path": [],
        "fields": {}
      },
      "inventory": {
        "method": "GET",
        "path": "",
        "params": {},
        "record_path": [],
        "fields": {}
      },
      "returns": {
        "method": "GET",
        "path": "",
        "params": {},
        "record_path": [],
        "fields": {}
      }
    }
